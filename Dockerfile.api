# Stage 1: deps (cached as long as lockfile doesn't change)
FROM oven/bun:1-alpine AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN bun install --frozen-lockfile

# Stage 2: build
FROM deps AS build
WORKDIR /app
COPY . .
# Prisma 6.x + Bun ne joue pas bien : `bunx prisma generate` tente d'installer
# @prisma/client via npm (post-install hook) qui échoue dans le container alpine.
# Workaround : utiliser npx + le nodejs/npm pré-installés.
RUN apk add --no-cache nodejs npm
RUN npx prisma generate
RUN cd packages/shared && bun run build
RUN bun run build:api

# Stage 3: production deps only (no devDependencies)
FROM oven/bun:1-alpine AS prod-deps
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN bun install --frozen-lockfile --production --ignore-scripts

# Stage 4: runtime
FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl
COPY --from=build /app/apps/api/dist ./dist
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY packages/shared/package.prod.json ./packages/shared/package.json
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma ./node_modules/@prisma
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs
EXPOSE 3000
ENV NODE_ENV=production
CMD ["node", "dist/main.js"]
